{
  "expo": {
    "name": "Earbuds Translator",
    "slug": "earbud-trans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090D16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patdev.earbudtrans",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "App cần quyền micro để nhận diện giọng nói từ tai nghe của bạn.",
        "NSBluetoothAlwaysUsageDescription": "App cần kết nối Bluetooth để thu âm giọng nói trực tiếp qua tai nghe không dây.",
        "NSBluetoothPeripheralUsageDescription": "App cần kết nối Bluetooth để thu âm giọng nói trực tiếp qua tai nghe không dây.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.patdev.earbudtrans",
      "adaptiveIcon": {
        "backgroundColor": "#090D16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "c86f0c5d-2c57-4a37-8ba6-73bcb6ff0095"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c86f0c5d-2c57-4a37-8ba6-73bcb6ff0095"
    }
  }
}
